+
+test "a DSML block is read from its own tags: <tool_call> text around it or in an argument moves nothing" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const tools = (try json.parse(a, "[{\"type\":\"function\",\"function\":{\"name\":\"weather\"}},{\"type\":\"function\",\"function\":{\"name\":\"write\"}}]")).ok.array;
+    const D = "\u{ff5c}DSML\u{ff5c}";
+    const quoted = "a </tool_call> and <tool_call>{\"name\": \"weather\", \"arguments\": {}}</tool_call>";
+    const block = "<" ++ D ++ " calls>\n<" ++ D ++ " invoke name=\"write\">\n<" ++ D ++ " parameter name=\"content\" string=\"true\">" ++ quoted ++ "</" ++ D ++ " parameter>\n</" ++ D ++ " invoke>\n</" ++ D ++ " calls>";
+    // a <tool_call> in the prose before the block, and a </tool_call> and a whole call in its argument
+    const r = try parse(a, "I will not use <tool_call> here.\n\n" ++ block, tools, null);
+    try std.testing.expectEqualStrings("I will not use <tool_call> here.", r.content);
+    try std.testing.expectEqual(@as(usize, 1), r.calls.?.len);
+    try std.testing.expectEqualStrings("write", r.calls.?[0].get("function").?.get("name").?.string);
+    const args = (try json.parse(a, r.calls.?[0].get("function").?.get("arguments").?.string)).ok;
+    try std.testing.expectEqualStrings(quoted, args.get("content").?.string);
+    // calls keep the reply's order: a <tool_call> call before the block comes first
+    const both = try parse(a, "<tool_call>{\"name\": \"weather\", \"arguments\": {\"city\": \"Oslo\"}}</tool_call>\n" ++ block, tools, null);
+    try std.testing.expectEqual(@as(usize, 2), both.calls.?.len);
+    try std.testing.expectEqualStrings("weather", both.calls.?[0].get("function").?.get("name").?.string);
+    try std.testing.expectEqualStrings("write", both.calls.?[1].get("function").?.get("name").?.string);
+    // the call streamer reads only the text before the first block
+    try std.testing.expectEqualStrings("Hi. ", tool_parse.beforeDsml("Hi. " ++ block ++ " more"));
+    try std.testing.expectEqualStrings("no block", tool_parse.beforeDsml("no block"));
+}
diff --git a/zig/tests/dsv41/template_check.zig b/zig/tests/dsv41/template_check.zig
new file mode 100644
index 00000000..5e3d92b0
--- /dev/null
+++ b/zig/tests/dsv41/template_check.zig
@@ -0,0 +1,30 @@
+//! The 1017 chat template on this engine's template module: it compiles and renders. The template is
+//! tools/dsv41-zig/serving/chat_template.jinja (the 1017 checkpoint ships none; this is ours, checked against DeepSeek's
+//! reference renderings). Not part of `zig build test` (the template module is not a test root there); run it with:
+//!
+//!   TPL=tools/dsv41-zig/serving/chat_template.jinja \
+//!     zig test -lc --dep template -Mroot=zig/tests/dsv41/template_check.zig \
+//!       -Mtemplate=zig/src/core/template/template.zig
+const std = @import("std");
+const template = @import("template");
+
+test "the 1017 chat template compiles and renders (TPL)" {
+    const path = std.c.getenv("TPL") orelse return error.SkipZigTest;
+    const a = std.testing.allocator;
+    const src = try std.Io.Dir.cwd().readFileAlloc(std.testing.io, std.mem.span(path), a, .limited(1 << 20));
+    defer a.free(src);
+    var diag = template.Diag{};
+    defer if (diag.msg.len > 0) a.free(diag.msg);
+    const parsed = try std.json.parseFromSlice(std.json.Value, a, "{\"messages\":[{\"role\":\"system\",\"content\":\"You are helpful.\"},{\"role\":\"user\",\"content\":\"Hi\"},{\"role\":\"assistant\",\"content\":\"Hello\"},{\"role\":\"user\",\"content\":\"Bye\"}]}", .{});
+    defer parsed.deinit();
+    const out = template.renderChat(a, src, parsed.value.object.get("messages").?, .null, parsed.value, true, &diag) catch |err| {
+        std.debug.print("TPL FAIL {t}: {s}\n", .{ err, diag.msg });
+        return err;
+    };
+    defer a.free(out);
+    // the header's system span and the two user turns are there, and the generation prompt opens the assistant turn
+    try std.testing.expect(std.mem.indexOf(u8, out, "You are helpful.") != null);
+    try std.testing.expect(std.mem.indexOf(u8, out, "Hi") != null);
+    try std.testing.expect(std.mem.indexOf(u8, out, "Bye") != null);
+    std.debug.print("TPL {s}: compiled and rendered {d} bytes\n", .{ std.mem.span(path), out.len });
+}
