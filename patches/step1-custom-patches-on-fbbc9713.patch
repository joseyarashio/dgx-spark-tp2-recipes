+        try read(&sh, w.key, buf.items);
+        h.update(buf.items);
+        n += 1;
+        bytes += len;
+    }
+    var out: [32]u8 = undefined;
+    h.final(&out);
+    std.debug.print("TF_DSV41_DIGEST_PACK {s}: {d} entries, {d} bytes, sha256 {x}\n", .{ std.mem.span(dir), n, bytes, out });
+}
