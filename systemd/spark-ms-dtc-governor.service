[Unit]
Description=DGX Spark MS-DTC GPU clock governor (Node1 + Node2 via SSH, reads /dev/shm/dgx_cluster_state)
After=network-online.target spark-fastfail-proxy.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /home/joseyarashio/dgx-spark-tp2-recipes/scripts/ms_dtc_governor.py
StandardOutput=append:/home/joseyarashio/.cache/ms_dtc_governor.log
StandardError=append:/home/joseyarashio/.cache/ms_dtc_governor.log
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
