[Unit]
Description=DGX Spark TP=2 post-reboot self-verification (only when armed)
ConditionPathExists=/home/joseyarashio/.cache/spark-reboot-verify/armed.json
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -u /home/joseyarashio/dgx-spark-tp2-recipes/scripts/post_reboot_verify.py run
StandardOutput=append:/home/joseyarashio/.cache/spark-reboot-verify/run.log
StandardError=append:/home/joseyarashio/.cache/spark-reboot-verify/run.log
TimeoutStartSec=150min
