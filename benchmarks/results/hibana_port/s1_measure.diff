+            const hb = m.xd_host.?.bytes;
+            const half = m.rd.xdump_half;
+            var n: usize = 0;
+            n += @intCast(@max(0, std.c.write(m.xs_fd, std.mem.asBytes(&hdr).ptr, 32)));
